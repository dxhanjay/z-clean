{
  "expo": {
    "name": "Z-clean",
    "slug": "z-clean",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zclean",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#22786d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.zclean.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "in.zclean.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22786d"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Z-clean uses the camera to scan an order's QR tag when staff complete a handover.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://z-clean-iota.vercel.app",
      "supabaseUrl": "https://hvoqfcwtrlaszqsajlho.supabase.co",
      "supabasePublishableKey": "sb_publishable_HpBnkz1IqUNgsL_hPpbHKQ_5vE9TI-s"
    }
  }
}
