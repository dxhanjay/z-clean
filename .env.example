# ─── Z-clean environment ────────────────────────────────────────────────────
# Copy to .env.local and fill with REAL values from your own accounts.
# Never commit .env.local. Never put secret keys in client-side code.

# Supabase — Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical public site URL (used for password-reset redirect links).
# Strongly recommended in production; when unset, links are derived
# from the incoming request's host headers.
NEXT_PUBLIC_SITE_URL=

# Demo mode (P0 fail-closed): demo data activates ONLY when this is
# exactly "true", or when Supabase env vars are missing in a
# non-production build. A production build with missing Supabase env
# vars and no demo flag serves a configuration error instead.
# Leave unset for real deployments.
NEXT_PUBLIC_DEMO_MODE=

# Supabase service-role key — SERVER ONLY (used by the verified payment
# webhook and admin jobs in later phases; bypasses RLS, keep it secret)
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Payment Link (interim online payment, owner decision
# 2026-11-04: full gateway setup below is DEFERRED). Paste the public
# Payment Link URL created in the Razorpay dashboard (rzp.io / pages
# URL). Overrides the pasted value in src/lib/config.ts. Leave empty to
# show online payment as "setting up soon" (Pay on Delivery still works).
NEXT_PUBLIC_RAZORPAY_PAYMENT_LINK=

# Razorpay — test mode keys first (Dashboard → Settings → API Keys)
# (Deferred: only needed for the full Checkout.js gateway setup.)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook secret — must match the secret set on the webhook in the
# Razorpay dashboard (URL: <your-domain>/api/payments/webhook, events:
# payment.captured + payment.failed). The webhook is the ONLY path that
# marks an order paid — the browser callback never does.
RAZORPAY_WEBHOOK_SECRET=
